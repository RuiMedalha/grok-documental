# Database
DATABASE_URL="postgresql://docflow:docflow@localhost:5432/docflow?schema=public"

# Redis
REDIS_URL="redis://localhost:6379"

# JWT
JWT_SECRET="change-me-super-secret-jwt-key-at-least-32-chars"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_SECRET="change-me-super-secret-refresh-key-at-least-32-chars"
JWT_REFRESH_EXPIRES_IN="7d"

# S3 / MinIO
S3_ENDPOINT="http://localhost:9000"
S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="docflow"
S3_REGION="us-east-1"
S3_FORCE_PATH_STYLE="true"

# App
API_PORT=3001
API_URL="http://localhost:3001"
WEB_URL="http://localhost:3000"
NODE_ENV="development"

# Rate limiting
THROTTLE_TTL=60
THROTTLE_LIMIT=100
